<?php 
 $results = $pageData['searchResult']['results'];
 $currentPage = $pageData['searchResult']['current_page'];
 $count = $pageData['searchResult']['count'];
 $totalPages = $pageData['searchResult']['total_pages'];
 $params = $pageData['params'];

 parse_str($params, result: $query);
 unset($query['page']);
 $queryString = http_build_query($query);

 $prevPage = $currentPage - 1;
 $nextPage = $currentPage + 1;

 $isPrevDisabled = $currentPage <= 1;
 $prevPageHref = $isPrevDisabled ? 'javascript:void(0)' : '?' . $queryString . '&page=' . ($currentPage - 1);
 $prevPageClass = 'co' . ($isPrevDisabled ? ' muted' : '');

 $isNextDisabled = $currentPage >= $totalPages;
 $nextPageHref = $isNextDisabled ? 'javascript:void(0)' : '?' . $queryString . '&page=' . ($currentPage + 1);
 $nextPageClass = 'co' . ($isNextDisabled ? ' muted' : '');

 $q = $query['q'] ?? null;
 $category = isset($query['category']) ? strtolower($query['category']) : null;

 $pageRouting = [['name' => 'Home', 'href' => '/']];
 if ($category) {
 $pageRouting[] = [
 'name' => 'All categories',
 'href' => '/categories',
 ];
 $pageRouting[] = [
 'name' => $category,
 'href' => '/s?category=' . urlencode($category),
 ];
 if ($q) {
 $pageRouting[] = [
 'name' => $q,
 'href' => 'javascript:void(0)',
 ];
 }
 } else {
 $pageRouting[] = [
 'name' => 'All products',
 'href' => '/s',
 ];
 if ($q) {
 $pageRouting[] = [
 'name' => $q,
 'href' => 'javascript:void(0)',
 ];
 }
 }

 if ($q && $category) {
 $pageHeader = 'Search results for ' . ucfirst($q) . ' in ' . ucfirst($category);
 } elseif ($q) {
 $pageHeader = 'Search results for ' . ucfirst($q);
 } elseif ($category) {
 $pageHeader = 'Products in ' . ucfirst($category);
 } else {
 $pageHeader = 'All Products';
 }
 $siteName = 'Market Prime';
 $pageTitle =
 ucfirst($q ?? 'Products') . ($category ? ' in ' . ucfirst($category) : '') . " | Buy Online - $siteName";

 $pageTitle = htmlspecialchars($pageTitle);
 $pageHeader = htmlspecialchars($pageHeader);

 $scheme = !empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off' ? 'https' : 'http';
 $host = $_SERVER['HTTP_HOST'];

 $breadcrumbJson = [
 '@context' => 'https://schema.org',
 '@type' => 'BreadcrumbList',
 'itemListElement' => [],
 ];
 foreach ($pageRouting as $i => $route) {
 $breadcrumbJson['itemListElement'][] = [
 '@type' => 'ListItem',
 'position' => $i + 1,
 'name' => $route['name'],
 'item' => $scheme . '://' . $host . $route['href'],
 ];
 }
 ?>

<?php $_shouldextend[1]=1; ?>
<?php $this->startSection('content'); ?>
 <main class="home pl-main">
 <div class="pl-meta">
 <div class="pl-dir flx items-center">
 <?php $__currentLoopData = $pageRouting; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $index => $route): $loop = $this->incrementLoopIndices();  ?>
 <?php if($index === array_key_last($pageRouting)): ?>
 <span><?php echo \htmlentities($route['name']??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 <?php else: ?>
 <a href="<?php echo \htmlentities($route['href']??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities($route['name']??'', ENT_QUOTES, 'UTF-8', false); ?></a>
 <i class="fa fa-angle-right"></i>
 <?php endif; ?>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>

 </div>
 <div class="pl-cont">
 <div class="pl-filter-cont">
 Filter options here
 </div>
 <div class="pl-listing-cont">
 <div class="h flx items-center pl-head">
 <h1 class="fnt-bold"><?php echo \htmlentities($pageHeader??'', ENT_QUOTES, 'UTF-8', false); ?></h1>
 <p>(<?php echo \htmlentities($count??'', ENT_QUOTES, 'UTF-8', false); ?> products found)</p>
 </div>
 <div class="bod">
 <?php $__currentLoopData = $results; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $product): $loop = $this->incrementLoopIndices();  ?>
 <a href="/product-detail?p-id=<?php echo \htmlentities($product['id']??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <div class="pl-item">
 <div class="img" style="background-image: url('<?php echo \htmlentities($product['base_image']??'', ENT_QUOTES, 'UTF-8', false); ?>')">
 <?php if(!empty($product['flash_deal'])): ?>
 <div class="absolute top-1 left-1 flex-col flex items-start gap-1">
 <?php $__currentLoopData = $product['flash_deal']; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $flash_data): $loop = $this->incrementLoopIndices();  ?>
 <?php 
 $badgeColor =
 $flash_data['type'] == 0
 ? 'text-red-400 bg-red-200/25'
 : 'text-blue-400 bg-blue-200/25';
 ?>
 <span
 class="<?php echo \htmlentities($badgeColor??'', ENT_QUOTES, 'UTF-8', false); ?> flex flex-col items-center justify-center backdrop-blur-sm px-1 rounded-lg text-xs pl1-tag">
 <?php echo \htmlentities($flash_data['name']??'', ENT_QUOTES, 'UTF-8', false); ?>

 </span>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>
 <?php endif; ?>
 </div>
 <div class="pl-deets">
 <p class="name fnt-bold"><?php echo \htmlentities(mb_strimwidth($product['name'], 0, 30, '...')??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 <p class="desc"><?php echo \htmlentities(mb_strimwidth($product['description'], 0, 30, '...')??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 <p class="price fnt-bold">&#8358; <?php echo \htmlentities(number_format($product['price'], 2)??'', ENT_QUOTES, 'UTF-8', false); ?></p>
 <div class="star-rating">
 <?php 
 $rating = $product['rating'] ?? 4;
 ?>
 <?php for($i = 1; $i <= 5; $i++): ?>
 <?php if($i <= $rating): ?>
 <span class="star">&#9733;</span>
 <?php else: ?>
 <span class="star empty">&#9734;</span>
 <?php endif; ?>
 <?php endfor; ?>
 </div>
 </div>
 <div class="pl-cta">
 <button class="atc fnt-bold">Add to cart</button>
 </div>
 </div>
 </a>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
 </div>

 <div class="pl-pager">
 <a href="<?php echo \htmlentities($prevPageHref??'', ENT_QUOTES, 'UTF-8', false); ?>" class="<?php echo \htmlentities($prevPageClass??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <svg width="10" height="10" viewBox="0 0 14 14" fill="none"
 xmlns="http://www.w3.org/2000/svg">
 <path d="M12.8332 6.99996H1.1665M1.1665 6.99996L6.99984 12.8333M1.1665 6.99996L6.99984 1.16663"
 stroke="black" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round" />
 </svg>
 <span class="fnt-medium">Previous</span>
 </a>

 <div class="pgs">
 <span class="counter"><?php echo \htmlentities($currentPage??'', ENT_QUOTES, 'UTF-8', false); ?></span>
 </div>
 <a href="<?php echo \htmlentities($nextPageHref??'', ENT_QUOTES, 'UTF-8', false); ?>" class="<?php echo \htmlentities($nextPageClass??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <span class="fnt-medium">Next</span>
 <svg width="10" height="10" viewBox="0 0 14 14" fill="none"
 xmlns="http://www.w3.org/2000/svg">
 <path
 d="M1.1665 6.99996H12.8332M12.8332 6.99996L6.99984 1.16663M12.8332 6.99996L6.99984 12.8333"
 stroke="black" stroke-width="1.67" stroke-linecap="round" stroke-linejoin="round" />
 </svg>
 </a>
 </div>
 </div>

 </div>
 <script type="application/ld+json">
 <?= json_encode($breadcrumbJson, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?>
 </script>
 </main>
<?php $this->stopSection(); ?>

<?php if (isset($_shouldextend[1])) { echo $this->runChild('layout.main', ['categories' => $pageData['categoriesData'], 'pageTitle' => $pageTitle]); } ?>